<svg id="lvy-mascotSvg" viewBox="0 0 500 500" xmlns="http://www.w3.org/2000/svg">
<defs>
<!-- Mascot Color Gradients -->
<linearGradient id="lvy-bodyGrad" x1="0%" y1="0%" x2="100%" y2="100%">
<stop id="lvy-gradStop1" offset="0%" stop-color="#FCD34D" />
<stop id="lvy-gradStop2" offset="50%" stop-color="#F59E0B" />
<stop id="lvy-gradStop3" offset="100%" stop-color="#D97706" />
</linearGradient>
<!-- Shiny 3D Bevel Gradient -->
<linearGradient id="lvy-bevelGrad" x1="0%" y1="0%" x2="0%" y2="100%">
<stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.8" />
<stop offset="25%" stop-color="#FFFFFF" stop-opacity="0.1" />
<stop offset="100%" stop-color="#000000" stop-opacity="0.4" />
</linearGradient>
<!-- Sneaker sole gradient -->
<linearGradient id="lvy-soleGrad" x1="0%" y1="0%" x2="0%" y2="100%">
<stop offset="0%" stop-color="#FFFFFF" />
<stop offset="100%" stop-color="#CBD5E1" />
</linearGradient>
<!-- Gold chain gradient -->
<linearGradient id="lvy-goldChainGrad" x1="0%" y1="0%" x2="100%" y2="0%">
<stop offset="0%" stop-color="#FBBF24" />
<stop offset="50%" stop-color="#FEF08A" />
<stop offset="100%" stop-color="#D97706" />
</linearGradient>
<!-- Drop shadow filter for street-sticker feel -->
<filter id="lvy-streetGlow" x="-20%" y="-20%" width="140%" height="140%">
<feDropShadow dx="0" dy="16" stdDeviation="18" flood-color="#000000" flood-opacity="0.5" />
<feDropShadow dx="0" dy="4" stdDeviation="4" flood-color="#000000" flood-opacity="0.25" />
</filter>
</defs>
<!-- Background dynamic graffiti badge circle -->
<g id="lvy-bgBadgeGroup">
<circle cx="250" cy="250" r="210" fill="#0F172A" stroke="#334155" stroke-width="8" stroke-dasharray="10 14" opacity="0.6" />
<circle id="lvy-bgSplashCircle" cx="250" cy="250" r="185" fill="#F59E0B" opacity="0.15" />
<!-- Street slash accents -->
<path d="M 90 280 L 140 230" stroke="#F59E0B" stroke-width="10" stroke-linecap="round" opacity="0.4" />
<path d="M 370 140 L 420 90" stroke="#F59E0B" stroke-width="8" stroke-linecap="round" opacity="0.4" />
<circle cx="390" cy="280" r="8" fill="#F59E0B" opacity="0.4" />
</g>
<!-- Mascot Main Root Group with swagger bounce animation -->
<g id="lvy-mascotRoot" filter="url(#lvy-streetGlow)">
<!-- LEGS & SNEAKERS (Feet) -->
<g id="lvy-legsGroup">
<!-- Left Leg -->
<path d="M 185 320 L 165 375" stroke="#0F172A" stroke-width="26" stroke-linecap="round" />
<path d="M 185 320 L 165 375" stroke="#1E293B" stroke-width="16" stroke-linecap="round" />
<!-- Right Leg (Tilted out cockily) -->
<path d="M 305 320 L 335 375" stroke="#0F172A" stroke-width="26" stroke-linecap="round" />
<path d="M 305 320 L 335 375" stroke="#1E293B" stroke-width="16" stroke-linecap="round" />
<!-- Left Sneaker (High-top Street Sneaker) -->
<g id="lvy-leftShoe" transform="translate(115, 360)">
<!-- Shoe Base Outer Shadow -->
<path d="M 5 40 Q 20 40 45 42 Q 75 42 85 30 L 80 15 Q 65 10 50 15 L 20 20 L 5 40 Z" fill="#0F172A" />
<!-- Shoe Sole (Thick Chunky Air Sole) -->
<rect x="0" y="36" width="90" height="18" rx="8" fill="url(#lvy-soleGrad)" stroke="#0F172A" stroke-width="4" />
<!-- Sole lines -->
<line x1="25" y1="42" x2="25" y2="50" stroke="#94A3B8" stroke-width="3" stroke-linecap="round" />
<line x1="45" y1="42" x2="45" y2="50" stroke="#94A3B8" stroke-width="3" stroke-linecap="round" />
<line x1="65" y1="42" x2="65" y2="50" stroke="#94A3B8" stroke-width="3" stroke-linecap="round" />
<!-- Shoe Upper -->
<path id="lvy-shoeUpperLeft" d="M 10 36 L 25 15 L 50 10 L 78 18 L 84 36 Z" fill="#EF4444" stroke="#0F172A" stroke-width="5" stroke-linejoin="round" />
<!-- Shoe Toe Cap & Swoosh Lightning Accent -->
<path d="M 10 36 Q 15 22 30 24 L 35 36 Z" fill="#FFFFFF" stroke="#0F172A" stroke-width="4" />
<path d="M 35 24 Q 55 18 70 30" stroke="#FFFFFF" stroke-width="5" stroke-linecap="round" fill="none" />
<!-- Sneaker Laces -->
<line x1="42" y1="16" x2="56" y2="20" stroke="#FEF08A" stroke-width="3.5" stroke-linecap="round" />
<line x1="46" y1="22" x2="60" y2="26" stroke="#FEF08A" stroke-width="3.5" stroke-linecap="round" />
</g>
<!-- Right Sneaker (Tilted foot tapping swagger) -->
<g id="lvy-rightShoe" transform="translate(295, 360)">
<!-- Shoe Sole -->
<rect x="0" y="36" width="95" height="18" rx="8" fill="url(#lvy-soleGrad)" stroke="#0F172A" stroke-width="4" />
<line x1="28" y1="42" x2="28" y2="50" stroke="#94A3B8" stroke-width="3" stroke-linecap="round" />
<line x1="50" y1="42" x2="50" y2="50" stroke="#94A3B8" stroke-width="3" stroke-linecap="round" />
<line x1="72" y1="42" x2="72" y2="50" stroke="#94A3B8" stroke-width="3" stroke-linecap="round" />
<!-- Shoe Upper -->
<path id="lvy-shoeUpperRight" d="M 12 36 L 22 18 L 52 10 L 82 15 L 90 36 Z" fill="#EF4444" stroke="#0F172A" stroke-width="5" stroke-linejoin="round" />
<!-- Toe Cap & Accents -->
<path d="M 68 36 Q 75 22 90 28 L 90 36 Z" fill="#FFFFFF" stroke="#0F172A" stroke-width="4" />
<path d="M 28 30 Q 48 18 68 24" stroke="#FFFFFF" stroke-width="5" stroke-linecap="round" fill="none" />
<!-- Sneaker Laces -->
<line x1="38" y1="20" x2="52" y2="16" stroke="#FEF08A" stroke-width="3.5" stroke-linecap="round" />
<line x1="44" y1="26" x2="58" y2="22" stroke="#FEF08A" stroke-width="3.5" stroke-linecap="round" />
</g>
</g>
<!-- THE "L" BODY -->
<!-- Outer Sticker Outline Border for thick streetwear logo aesthetics -->
<path d="M 130 90 
                       Q 130 70 150 70 
                       L 215 70 
                       Q 235 70 235 90 
                       L 235 250 
                       L 345 250 
                       Q 365 250 365 270 
                       L 365 320 
                       Q 365 340 345 340 
                       L 150 340 
                       Q 130 340 130 320 
                       Z" 
                    fill="#0F172A" 
                    stroke="#0F172A" 
                    stroke-width="26" 
                    stroke-linejoin="round" />
<!-- Main Colored Letter L -->
<path id="lvy-letterLBody" d="M 130 90 
                       Q 130 70 150 70 
                       L 215 70 
                       Q 235 70 235 90 
                       L 235 250 
                       L 345 250 
                       Q 365 250 365 270 
                       L 365 320 
                       Q 365 340 345 340 
                       L 150 340 
                       Q 130 340 130 320 
                       Z" 
                    fill="url(#lvy-bodyGrad)" 
                    stroke="#0F172A" 
                    stroke-width="8" 
                    stroke-linejoin="round" />
<!-- 3D Bevel / Highlight Inner Path -->
<path d="M 140 92 
                       L 152 82 
                       L 212 82 
                       L 225 94 
                       L 225 240 
                       L 340 240 
                       L 353 260 
                       L 353 328 
                       L 344 330 
                       L 335 260 
                       L 218 260 
                       L 218 94 
                       L 140 92 Z" 
                    fill="url(#lvy-bevelGrad)" 
                    opacity="0.6" />
<!-- Left Side Glossy Edge Highlight -->
<path d="M 142 95 L 142 325" stroke="#FFFFFF" stroke-width="6" stroke-linecap="round" opacity="0.5" />
<!-- ARMS & HANDS -->
<!-- Left Arm: Hand on hip, cocky boss stance -->
<g id="lvy-leftArm">
<path d="M 135 200 Q 80 215 95 265 Q 105 285 138 275" fill="none" stroke="#0F172A" stroke-width="24" stroke-linecap="round" stroke-linejoin="round" />
<path d="M 135 200 Q 80 215 95 265 Q 105 285 138 275" fill="none" stroke="#F59E0B" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" />
<!-- Glove on hip -->
<circle cx="125" cy="272" r="16" fill="#FFFFFF" stroke="#0F172A" stroke-width="5" />
<circle cx="115" cy="265" r="7" fill="#FFFFFF" stroke="#0F172A" stroke-width="4" />
</g>
<!-- Right Arm: Making the "Call Me / Shaka / Swagger Point" pose -->
<g id="lvy-rightArm" transform="translate(0, 0)">
<path d="M 235 190 Q 285 185 315 155" fill="none" stroke="#0F172A" stroke-width="24" stroke-linecap="round" />
<path d="M 235 190 Q 285 185 315 155" fill="none" stroke="#F59E0B" stroke-width="14" stroke-linecap="round" />
<!-- White Streetwear Glove with fingers -->
<g transform="translate(315, 140)">
<!-- Palm -->
<circle cx="10" cy="12" r="15" fill="#FFFFFF" stroke="#0F172A" stroke-width="5" />
<!-- Thumb extended out -->
<path d="M 16 0 C 26 -2 30 10 18 16" fill="#FFFFFF" stroke="#0F172A" stroke-width="5" stroke-linecap="round" />
<!-- Pinky / Finger pointing up -->
<path d="M -4 20 C -12 28 -2 34 8 24" fill="#FFFFFF" stroke="#0F172A" stroke-width="5" stroke-linecap="round" />
<!-- Wrist cuff -->
<rect x="0" y="20" width="16" height="8" rx="3" transform="rotate(-30 8 24)" fill="#0F172A" />
</g>
</g>
<!-- CARTOON FACE: EYES, BROWS, AND SMUG SMIRK -->
<g id="lvy-faceGroup" transform="translate(0, 0)">
<!-- Left Eye (Big Arrogant Cartoony) -->
<g id="lvy-leftEyeGroup" transform="translate(155, 120)">
<!-- White Eye Sclera -->
<ellipse cx="18" cy="22" rx="18" ry="24" fill="#FFFFFF" stroke="#0F172A" stroke-width="6" />
<!-- Pupil & Iris (Dynamic pupil movement via JS) -->
<g id="lvy-leftPupil" transform="translate(20, 22)">
<ellipse cx="0" cy="0" rx="9" ry="12" fill="#0F172A" />
<!-- Blue Iris ring -->
<circle cx="-1" cy="0" r="4.5" fill="#3B82F6" />
<!-- White sparkle reflection -->
<circle cx="-3" cy="-4" r="3.5" fill="#FFFFFF" />
</g>
<!-- Slanted Eyelid for the "Looking down at you" (装逼俯视) expression -->
<path id="lvy-leftEyelid" d="M -2 15 Q 18 25 38 12 L 38 0 L -2 0 Z" fill="#F59E0B" stroke="#0F172A" stroke-width="6" stroke-linejoin="round" />
<!-- Eyelash / Cheek line -->
<path d="M 0 38 Q 18 45 34 38" stroke="#0F172A" stroke-width="3.5" stroke-linecap="round" fill="none" opacity="0.3" />
</g>
<!-- Right Eye (Slightly smaller perspective & raised eyebrow) -->
<g id="lvy-rightEyeGroup" transform="translate(200, 115)">
<!-- White Eye Sclera -->
<ellipse cx="16" cy="22" rx="16" ry="22" fill="#FFFFFF" stroke="#0F172A" stroke-width="6" />
<!-- Pupil & Iris -->
<g id="lvy-rightPupil" transform="translate(18, 22)">
<ellipse cx="0" cy="0" rx="8" ry="11" fill="#0F172A" />
<circle cx="-1" cy="0" r="4" fill="#3B82F6" />
<circle cx="-3" cy="-4" r="3" fill="#FFFFFF" />
</g>
<!-- Drooping arrogant eyelid -->
<path id="lvy-rightEyelid" d="M -2 16 Q 16 26 34 14 L 34 0 L -2 0 Z" fill="#F59E0B" stroke="#0F172A" stroke-width="6" stroke-linejoin="round" />
</g>
<!-- Cocky Eyebrows (Slanted into pure swagger disdain) -->
<g id="lvy-eyebrowsGroup">
<!-- Left Brow: High arrogant arch -->
<path id="lvy-leftEyebrow" d="M 148 118 Q 170 102 195 116" stroke="#0F172A" stroke-width="8" stroke-linecap="round" fill="none" />
<!-- Right Brow: Inquisitive smirk arch -->
<path id="lvy-rightEyebrow" d="M 204 112 Q 224 96 236 110" stroke="#0F172A" stroke-width="8" stroke-linecap="round" fill="none" />
</g>
<!-- Smug Smirk Mouth (斜嘴一笑，歪嘴战神风格) -->
<g id="lvy-mouthGroup" transform="translate(170, 175)">
<!-- Smirk curve -->
<path d="M 0 5 Q 15 22 38 4" stroke="#0F172A" stroke-width="6" stroke-linecap="round" fill="none" />
<!-- Smug corner dimple -->
<path d="M 36 2 Q 44 4 41 12" stroke="#0F172A" stroke-width="5" stroke-linecap="round" fill="none" />
<!-- Little golden tooth glint inside smirk -->
<rect x="22" y="10" width="6" height="5" rx="1" fill="#FEF08A" stroke="#0F172A" stroke-width="2" />
</g>
</g>
<!-- ACCESSORIES (Togglable via JavaScript) -->
<!-- 1. Thug Life / Cyber Aviator Sunglasses -->
<g id="lvy-accSunglasses">
<!-- Glasses Bridge -->
<path d="M 185 132 L 205 132" stroke="#111827" stroke-width="6" stroke-linecap="round" />
<!-- Left Lens -->
<polygon points="146,120 190,122 186,155 152,150" fill="#090D16" stroke="#000000" stroke-width="4" />
<!-- Right Lens -->
<polygon points="196,122 236,118 232,148 198,154" fill="#090D16" stroke="#000000" stroke-width="4" />
<!-- Cool 80s gradient reflection stripe on lens -->
<line x1="152" y1="126" x2="164" y2="148" stroke="#38BDF8" stroke-width="3" opacity="0.8" stroke-linecap="round" />
<line x1="160" y1="126" x2="172" y2="148" stroke="#F43F5E" stroke-width="3" opacity="0.7" stroke-linecap="round" />
<line x1="202" y1="126" x2="214" y2="148" stroke="#38BDF8" stroke-width="3" opacity="0.8" stroke-linecap="round" />
<line x1="210" y1="126" x2="222" y2="148" stroke="#F43F5E" stroke-width="3" opacity="0.7" stroke-linecap="round" />
</g>
<!-- 2. Big Fat Gold Cuban Link Chain with Medallion -->
<g id="lvy-accGoldChain" transform="translate(0, 0)">
<!-- Chain Arc -->
<path d="M 152 210 Q 185 270 220 220" fill="none" stroke="url(#lvy-goldChainGrad)" stroke-width="12" stroke-linecap="round" stroke-dasharray="2 3" />
<path d="M 152 210 Q 185 270 220 220" fill="none" stroke="#78350F" stroke-width="3" stroke-linecap="round" />
<!-- Big Gold Medallion ($ or L) -->
<g transform="translate(182, 252)">
<circle cx="0" cy="0" r="18" fill="url(#lvy-goldChainGrad)" stroke="#78350F" stroke-width="4" />
<text x="0" y="6" font-size="18" font-family="Montserrat, sans-serif" font-weight="900" fill="#78350F" text-anchor="middle">$</text>
<!-- Diamond Sparkle on Medallion -->
<polygon points="12,-12 14,-6 20,-4 14,-2 12,4 10,-2 4,-4 10,-6" fill="#FFFFFF" />
</g>
</g>
<!-- 3. Snapback Cap / Street Hat on top -->
<g id="lvy-accSnapback" transform="translate(125, 45)">
<!-- Cap dome -->
<path d="M 8 36 Q 48 -10 98 25 L 8 36 Z" fill="#1E293B" stroke="#0F172A" stroke-width="6" stroke-linejoin="round" />
<!-- Cap button on top -->
<circle cx="50" cy="8" r="5" fill="#EF4444" stroke="#0F172A" stroke-width="2" />
<!-- Flat Brim tilted sideways -->
<path d="M 80 26 Q 130 18 140 34 Q 100 45 70 34 Z" fill="#EF4444" stroke="#0F172A" stroke-width="6" stroke-linejoin="round" />
<!-- Cap sticker label -->
<circle cx="105" cy="30" r="6" fill="#FBBF24" stroke="#B45309" stroke-width="1" />
</g>
<!-- 4. Floating Diamond / Bling Sparkles -->
<g id="lvy-accBling">
<!-- Sparkle 1 near head -->
<g transform="translate(110, 80)">
<path d="M 0 -15 Q 0 0 15 0 Q 0 0 0 15 Q 0 0 -15 0 Q 0 0 0 -15 Z" fill="#FDE047" stroke="#0F172A" stroke-width="2" />
</g>
<!-- Sparkle 2 near foot -->
<g transform="translate(380, 260)">
<path d="M 0 -12 Q 0 0 12 0 Q 0 0 0 12 Q 0 0 -12 0 Q 0 0 0 -12 Z" fill="#67E8F9" stroke="#0F172A" stroke-width="2" />
</g>
<!-- Sparkle 3 near right arm -->
<g transform="translate(350, 130)">
<polygon points="0,-10 3,-3 10,0 3,3 0,10 -3,3 -10,0 -3,-3" fill="#FFFFFF" stroke="#0F172A" stroke-width="2" />
</g>
</g>
</g>
<!-- /#mascotRoot -->
<!-- Brand Typography Tagline at bottom -->
</svg>