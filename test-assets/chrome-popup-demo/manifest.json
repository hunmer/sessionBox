{
  "manifest_version": 3,
  "name": "SessionBox Popup Demo",
  "version": "1.0.0",
  "description": "用于测试扩展导入、popup 和 userscript 的最小 Chrome 扩展。",
  "action": {
    "default_title": "SessionBox Demo",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "userScripts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
