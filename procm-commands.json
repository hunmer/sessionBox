{
  "commands": {
    "dev": {
      "script": "pnpm",
      "args": ["run", "dev"],
      "desc": "Electron 开发模式，console 自动转发到 sessionbox room",
      "roomId": "sessionbox",
      "group": "sessionbox"
    },
    "build": {
      "script": "pnpm",
      "args": ["run", "build"],
      "desc": "构建主进程/预加载/渲染产物",
      "group": "sessionbox"
    },
    "preview": {
      "script": "pnpm",
      "args": ["run", "preview"],
      "desc": "预览构建产物",
      "group": "sessionbox"
    },
    "sync-server": {
      "script": "node",
      "args": ["server/sync-server.mjs"],
      "desc": "数据同步后端（端口 37400，数据目录 server/data）",
      "group": "sync",
      "port": 37400
    }
  }
}
