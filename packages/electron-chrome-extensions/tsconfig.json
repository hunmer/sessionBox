{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist/types",
    "declaration": true,
    "emitDeclarationOnly": true
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
